  "runs": [
    {
      "tool": {
        "driver": {
          "name": "coding-guidelines-boolean-column-negative-go",
          "version": "2.0.0",
          "informationUri": "https://github.com/alimtvnetwork/coding-guidelines-v24",
          "rules": [
            {
              "id": "BOOL-NEG-001",
              "name": "BooleanColumnNegativePrefix",
              "shortDescription": {
                "text": "Database boolean columns must not use Not/No prefixes (e.g. IsNotActive, HasNoLicense). Detected in Go via db:\"...\" / gorm:\"column:...\" struct tags and inside embedded SQL string literals. Suspect Cannot*/Dis*/Un* roots are flagged as warnings."
              },
              "helpUri": "https://github.com/alimtvnetwork/coding-guidelines-v24/blob/main/spec/02-coding-guidelines/../04-database-conventions/01-naming-conventions.md"
            }
          ]
        }
      },
      "results": []
    },
    {
      "tool": {
        "driver": {
          "name": "coding-guidelines-boolean-column-negative",
          "version": "2.0.0",
          "informationUri": "https://github.com/alimtvnetwork/coding-guidelines-v24",
          "rules": [
            {
              "id": "BOOL-NEG-001",
              "name": "BooleanColumnNegativePrefix",
              "shortDescription": {
                "text": "Database boolean columns must not use Not/No prefixes (e.g. IsNotActive, HasNoLicense). Use the positive form or store one canonical state and derive the inverse in code. Suspect Cannot*/Dis*/Un* roots are flagged as warnings."
              },
              "helpUri": "https://github.com/alimtvnetwork/coding-guidelines-v24/blob/main/spec/02-coding-guidelines/../04-database-conventions/01-naming-conventions.md"
            }
          ]
        }
      },
      "results": []
    },
