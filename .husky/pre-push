#!/usr/bin/env sh
# ============================================================
# Husky pre-push — mirrors the CI guards that fail most often.
#
# 1. Confirms sync-managed files are GREEN (npm run sync:check).
# 2. Runs a fast subset of lint-ci.sh (steps 1, 4–9, 14) — the
#    string/link/install-section/mermaid-validate guards that
#    catch >90% of CI failures, without the slow Go/Python
#    validators or full diagram render.
#
# Skip in emergencies with:  SKIP_PREPUSH=1 git push
# ============================================================

set -e

# ── Ensure bash and core unix tools are in PATH (Windows / GitHub Desktop) ──
if ! command -v bash >/dev/null 2>&1; then
  for _git_p in \
    "/c/Program Files/Git/bin" \
    "/c/Program Files/Git/usr/bin" \
    "/c/Program Files (x86)/Git/bin" \
    "/c/Program Files (x86)/Git/usr/bin" \
    "C:/Program Files/Git/bin" \
    "C:/Program Files/Git/usr/bin"; do
    [ -d "$_git_p" ] && PATH="$_git_p:$PATH"
  done
  if ! command -v bash >/dev/null 2>&1; then
    _git_cmd="$(command -v git 2>/dev/null || true)"
    if [ -n "$_git_cmd" ]; then
      _git_root="${_git_cmd%/*}"
      _git_root="${_git_root%/*}"
      [ -d "$_git_root/bin" ] && PATH="$_git_root/bin:$PATH"
      [ -d "$_git_root/usr/bin" ] && PATH="$_git_root/usr/bin:$PATH"
    fi
  fi
  export PATH
fi

if [ "${SKIP_PREPUSH:-0}" = "1" ]; then
  echo "  pre-push: SKIP_PREPUSH=1 set — skipping guards"
  exit 0
fi

echo "→ pre-push: sync:check"
if ! node scripts/sync-check.mjs || ! node scripts/sync-guidelines.mjs --check; then
  echo ""
  echo "  pre-push: sync:check failed — run \`npm run sync\` and commit before pushing."
  exit 1
fi

echo "→ pre-push: lint-ci fast subset (steps 1, 4–9, 14)"
for step in 1 4 5 6 7 8 9 14; do
  if ! bash scripts/lint-ci.sh --step "$step"; then
    echo ""
    echo "  pre-push: lint-ci step $step failed — fix before pushing (or SKIP_PREPUSH=1 to bypass)."
    exit 1
  fi
done

echo "→ pre-push: validate SS-02 slides Symptom/Rule/Action structure"
if ! node scripts/validate-slides-sra.mjs; then
  echo ""
  echo "  pre-push: validate-slides-sra.mjs failed — align every SS-02 slide with the SRA structure."
  exit 1
fi

echo "→ pre-push: guideline sync drift check"
if ! node scripts/sync-guidelines.mjs --check; then
  echo ""
  echo "  pre-push: sync-guidelines drift — run \`node scripts/sync-guidelines.mjs\` and commit before pushing."
  exit 1
fi

echo "→ pre-push: visual baseline coverage (strict)"
if ! node scripts/validate-visual-baselines.mjs --strict --list; then
  echo ""
  # Hint block extracted so both branches (sandbox vs host) are
  # covered by scripts/tests/pre-push-visual-hint.test.sh. Do not
  # inline the branching back here without also deleting that test.
  bash scripts/pre-push-visual-hint.sh
  exit 1
fi

echo "✓ pre-push guards passed"
