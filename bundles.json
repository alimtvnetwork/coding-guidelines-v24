{
  "$schema": "./bundles.schema.json",
  "repo": "alimtvnetwork/coding-guidelines-v24",
  "rawBase": "https://raw.githubusercontent.com/alimtvnetwork/coding-guidelines-v24/main",
  "releaseBase": "https://github.com/alimtvnetwork/coding-guidelines-v24/releases",
  "bundles": [
    {
      "name": "error-manage",
      "title": "Error Management Spec",
      "description": "Installs the error-management guidance plus the spec-authoring guide.",
      "intent": [
        "error handling",
        "apperror",
        "response envelope",
        "error codes",
        "typed query",
        "exception",
        "panic",
        "stack trace"
      ],
      "audience": "backend",
      "folders": [
        {
          "src": "02-spec/01-spec-authoring-guide",
          "dest": "02-spec/01-spec-authoring-guide"
        },
        {
          "src": "02-spec/03-error-manage",
          "dest": "02-spec/03-error-manage"
        },
        {
          "src": "version.json",
          "dest": "version.json"
        },
        {
          "src": ".lovable/what-to-read.md",
          "dest": ".lovable/what-to-read.md"
        },
        {
          "src": ".lovable/memory",
          "dest": ".lovable/memory"
        }
      ],
      "archive": {
        "stableName": "error-manage",
        "versionedPrefix": "coding-guidelines-error-manage"
      }
    },
    {
      "name": "splitdb",
      "title": "Split-DB Architecture Spec",
      "description": "Installs the database conventions, split-DB architecture, and seedable config specs.",
      "intent": [
        "database",
        "sqlite",
        "split db",
        "root app session",
        "rbac",
        "casbin",
        "seedable config",
        "schema",
        "migration",
        "wal"
      ],
      "audience": "backend",
      "folders": [
        {
          "src": "02-spec/04-database-conventions",
          "dest": "02-spec/04-database-conventions"
        },
        {
          "src": "02-spec/05-split-db-architecture",
          "dest": "02-spec/05-split-db-architecture"
        },
        {
          "src": "02-spec/06-seedable-config-architecture",
          "dest": "02-spec/06-seedable-config-architecture"
        },
        {
          "src": "version.json",
          "dest": "version.json"
        },
        {
          "src": ".lovable/what-to-read.md",
          "dest": ".lovable/what-to-read.md"
        },
        {
          "src": ".lovable/memory",
          "dest": ".lovable/memory"
        }
      ],
      "archive": {
        "stableName": "splitdb",
        "versionedPrefix": "coding-guidelines-splitdb"
      }
    },
    {
      "name": "slides",
      "title": "Slides App + Decks",
      "description": "Installs the slides Vite app, the source decks (spec-slides/), and the pre-built dist/ so index.html opens directly in the browser \u2014 no Node/build step required.",
      "intent": [
        "slides",
        "presentation",
        "training",
        "deck",
        "teach",
        "workshop",
        "onboarding"
      ],
      "audience": "trainer",
      "folders": [
        {
          "src": "spec-coding-guideline",
          "dest": "spec-coding-guideline"
        },
        {
          "src": "slides-app",
          "dest": "slides-app"
        },
        {
          "src": "version.json",
          "dest": "version.json"
        },
        {
          "src": ".lovable/what-to-read.md",
          "dest": ".lovable/what-to-read.md"
        },
        {
          "src": ".lovable/memory",
          "dest": ".lovable/memory"
        }
      ],
      "archive": {
        "stableName": "slides",
        "versionedPrefix": "coding-guidelines-slides"
      },
      "prebuilt": {
        "src": "slides-app/dist",
        "dest": "slides-app/dist",
        "build": "cd slides-app && bun install --frozen-lockfile && bun run build"
      },
      "autoOpen": {
        "entry": "slides-app/dist/index.html"
      },
      "verify": [
        {
          "path": "slides-app/dist/index.html",
          "kind": "file"
        },
        {
          "path": "spec-slides",
          "kind": "dir"
        }
      ]
    },
    {
      "name": "linters",
      "title": "Linters + CI/CD Linter Pack",
      "description": "Installs the project linters and the CI/CD linter runner pack.",
      "intent": [
        "lint",
        "linter",
        "static analysis",
        "golangci-lint",
        "phpcs",
        "sonarqube",
        "stylecop",
        "ci checks",
        "code quality"
      ],
      "audience": "devops",
      "folders": [
        {
          "src": "linters",
          "dest": "linters"
        },
        {
          "src": "linters-cicd",
          "dest": "linters-cicd"
        },
        {
          "src": "version.json",
          "dest": "version.json"
        },
        {
          "src": ".lovable/what-to-read.md",
          "dest": ".lovable/what-to-read.md"
        },
        {
          "src": ".lovable/memory",
          "dest": ".lovable/memory"
        }
      ],
      "archive": {
        "stableName": "linters",
        "versionedPrefix": "coding-guidelines-linters"
      }
    },
