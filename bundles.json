          "src": "02-spec/16-generic-release",
          "dest": "02-spec/16-generic-release"
        },
        {
          "src": "version.json",
          "dest": "version.json"
        },
        {
          "src": ".lovable/what-to-read.md",
          "dest": ".lovable/what-to-read.md"
        },
        {
          "src": ".lovable/memory",
          "dest": ".lovable/memory"
        }
      ],
      "archive": {
        "stableName": "cli",
        "versionedPrefix": "coding-guidelines-cli"
      }
    },
    {
